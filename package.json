{
  "name": "cv-builder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && vite build && node scripts/vercel-output.mjs",
    "start": "node --disable-warning=ExperimentalWarning server/index.ts --prod",
    "admin:reset": "node --disable-warning=ExperimentalWarning server/cli.ts reset-admin",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "docx": "^8.5.0",
    "express": "^4.21.2",
    "lucide-react": "^0.460.0",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.21.5",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
